{
  "expo": {
    "name": "What's Cooking",
    "slug": "whats-cooking",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",

    "scheme": "whatscooking",

    "assetBundlePatterns": [
      "**/*",
      "assets/food/**"
    ],

    "icon":  "./assets/icon.png",
    "splash": {
      "image":           "./assets/splash.png",
      "resizeMode":      "contain",
      "backgroundColor": "#FF6B35"
    },

    "android": {
      "package":            "com.sherwayne.whatscooking",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B35"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "statusBar": {
        "backgroundColor": "transparent",
        "translucent":     true,
        "barStyle":        "dark-content",
        "hidden":          false
      },
      "navigationBar": {
        "backgroundColor": "#FFFFFF",
        "barStyle":        "dark-content"
      }
    },

    "ios": {
      "supportsTablet":   true,
      "bundleIdentifier": "com.sherwayne.whatscooking",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "What's Cooking uses your location to find restaurants near you.",
        "NSLocationAlwaysUsageDescription":    "What's Cooking uses your location to find restaurants near you.",
        "NSCameraUsageDescription":            "What's Cooking needs camera access to scan menus and update your profile photo.",
        "NSPhotoLibraryUsageDescription":      "What's Cooking needs photo access to upload restaurant and menu images.",
        "NSPhotoLibraryAddUsageDescription":   "What's Cooking needs permission to save photos."
      }
    },

    "web": {
      "bundler": "metro"
    },

    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "What's Cooking uses your location to find restaurants near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "What's Cooking needs access to your photos to upload images.",
          "cameraPermission": "What's Cooking needs camera access to scan menus and take photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "What's Cooking needs camera access to scan menu pages."
        }
      ],
      [
        "expo-notifications",
        {
          "icon":  "./assets/icon.png",
          "color": "#FF6B35",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-system-ui",
        {
          "userInterfaceStyle": "light"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF6B35",
          "image":           "./assets/splash.png",
          "imageWidth":      200,
          "resizeMode":      "contain",
          "dark": {
            "backgroundColor": "#FF6B35",
            "image":           "./assets/splash.png"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion":  34,
            "buildToolsVersion": "34.0.0",
            "kotlinVersion":     "1.8.0"
          },
          "ios": {
            "deploymentTarget": "13.0"
          }
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "15062ebe-c1c0-4d13-9bf4-bcce99cc9e62"
      }
    }
  }
}