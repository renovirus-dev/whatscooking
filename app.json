{
  "expo": {
    "name": "What's Cooking",
    "slug": "whats-cooking",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "whatscooking",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.yourname.whatscooking",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B35"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.whatscooking",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "What's Cooking uses your location to find restaurants near you.",
        "NSLocationAlwaysUsageDescription": "What's Cooking uses your location to find restaurants near you.",
        "NSCameraUsageDescription": "What's Cooking needs camera access to scan menus and update your profile photo.",
        "NSPhotoLibraryUsageDescription": "What's Cooking needs photo access to upload restaurant and menu images.",
        "NSPhotoLibraryAddUsageDescription": "What's Cooking needs permission to save photos."
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "What's Cooking uses your location to find restaurants near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "What's Cooking needs access to your photos to upload images.",
          "cameraPermission": "What's Cooking needs camera access to scan menus and take photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "What's Cooking needs camera access to scan menu pages."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF6B35",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-system-ui",
        {
          "userInterfaceStyle": "light"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "35.0.0",
            "kotlinVersion": "2.1.20"
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF6B35",
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "15062ebe-c1c0-4d13-9bf4-bcce99cc9e62"
      }
    }
  }
}
